generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attempts {
  id           String    @id @default(uuid())
  user_id      String
  test_id      String
  score        Int?
  responses    String?   @db.LongText
  submitted_at DateTime? @default(now())
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "attempts_user_id_fkey")
}

model blogs {
  id                     String      @id @default(uuid())
  title                  String
  slug                   String      @unique
  excerpt                String?
  content                String?
  image_url              String?     @db.LongText
  tags                   String      @db.LongText
  faqs                   String?     @db.LongText
  is_featured            Boolean?    @default(false)
  is_published           Boolean?    @default(true)
  created_at             DateTime    @default(now())
  category_id            String?
  meta_title             String?
  meta_description       String?
  keywords               String      @db.LongText
  robots                 String?     @default("index, follow")
  canonical_url          String?
  og_title               String?
  og_description         String?
  og_image_url           String?     @db.LongText
  author_id              String?
  enable_structured_data Boolean?    @default(true)
  profiles               profiles?   @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories             categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([author_id], map: "blogs_author_id_fkey")
  @@index([category_id], map: "blogs_category_id_fkey")
}

model categories {
  id          String    @id @default(uuid())
  title       String
  description String?
  icon_key    String?
  bg_color    String?
  order_index Int?      @default(0)
  created_at  DateTime? @default(now())
  blogs       blogs[]
  courses     courses[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contact_messages {
  id              String         @id @default(uuid())
  created_at      DateTime?      @default(now())
  name            String
  email           String
  message         String
  status          String?        @default("unread")
  organization_id String?
  subject         String?
  organizations   organizations? @relation(fields: [organization_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "contact_messages_organization_id_fkey")
}

model courses {
  id                    String                  @id @default(uuid())
  title                 String
  description           String?
  is_published          Boolean?                @default(true)
  created_at            DateTime?               @default(now())
  category_id           String?
  slug                  String?                 @unique
  details               String?                 @db.LongText
  categories            categories?             @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  exam_rank_predictions exam_rank_predictions[]
  exams                 exams[]
  mock_blueprints       mock_blueprints[]
  mock_tests            mock_tests[]
  subjects              subjects[]

  @@index([slug], map: "idx_courses_slug")
  @@index([category_id], map: "courses_category_id_fkey")
}

model exam_attempts {
  id                 String          @id @default(uuid())
  user_id            String
  exam_id            String?
  practice_test_id   String?
  status             String          @default("in_progress")
  score              Int?            @default(0)
  total_marks        Int?            @default(0)
  duration_minutes   Int?            @default(0)
  time_taken_seconds Int?            @default(0)
  answers            String?         @db.LongText
  started_at         DateTime?       @default(now())
  completed_at       DateTime?
  mock_test_id       String?
  percentage         Decimal?        @default(0) @db.Decimal(10, 0)
  exams              exams?          @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mock_tests         mock_tests?     @relation(fields: [mock_test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  practice_tests     practice_tests? @relation(fields: [practice_test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mock_test_id], map: "idx_exam_attempts_mock_test")
  @@index([mock_test_id], map: "idx_exam_attempts_mock_test_id")
  @@index([user_id], map: "idx_exam_attempts_student")
  @@index([exam_id], map: "exam_attempts_exam_id_fkey")
  @@index([practice_test_id], map: "exam_attempts_practice_test_id_fkey")
}

model exam_rank_predictions {
  id                String      @id @default(uuid())
  exam_id           String?
  min_score         Decimal     @db.Decimal(10, 0)
  max_score         Decimal     @db.Decimal(10, 0)
  approx_rank       String?
  approx_percentile String?
  created_at        DateTime?   @default(now())
  course_id         String?
  courses           courses?    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mock_tests        mock_tests? @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id, min_score, max_score], map: "idx_rank_predictions_course_score")
  @@index([exam_id], map: "exam_rank_predictions_exam_id_fkey")
}

model exams {
  id                String          @id @default(uuid())
  title             String
  description       String?
  subject_id        String?
  duration_minutes  Int?            @default(60)
  is_published      Boolean?        @default(false)
  created_at        DateTime?       @default(now())
  category          String?         @default("practice")
  course_id         String?
  total_marks       Int?            @default(0)
  marks_correct     Decimal?        @default(4) @db.Decimal(10, 0)
  marks_incorrect   Decimal?        @default(-1) @db.Decimal(10, 0)
  marks_unattempted Decimal?        @default(0) @db.Decimal(10, 0)
  exam_attempts     exam_attempts[]
  courses           courses?        @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects          subjects?       @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  questions         questions[]

  @@index([course_id], map: "exams_course_id_fkey")
  @@index([subject_id], map: "exams_subject_id_fkey")
}

model mock_blueprint_items {
  id              String          @id @default(uuid())
  blueprint_id    String
  subject_id      String
  question_count  Int
  mock_blueprints mock_blueprints @relation(fields: [blueprint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects        subjects        @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([blueprint_id], map: "mock_blueprint_items_blueprint_id_fkey")
  @@index([subject_id], map: "mock_blueprint_items_subject_id_fkey")
}

model mock_blueprints {
  id                     String                 @id @default(uuid())
  course_id              String
  title                  String
  total_duration_minutes Int                    @default(180)
  total_marks            Int                    @default(300)
  created_at             DateTime?              @default(now())
  mock_blueprint_items   mock_blueprint_items[]
  courses                courses                @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "mock_blueprints_course_id_fkey")
}

model mock_test_questions {
  id           String     @id @default(uuid())
  mock_test_id String
  question_id  String
  created_at   DateTime?  @default(now())
  mock_tests   mock_tests @relation(fields: [mock_test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions    questions  @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([mock_test_id, question_id], map: "mock_test_questions_unique_pair")
  @@index([mock_test_id], map: "idx_mock_test_questions_mock_test_id")
  @@index([question_id], map: "mock_test_questions_question_id_fkey")
}

model mock_tests {
  id                    String                  @id @default(uuid())
  course_id             String
  title                 String
  description           String?
  duration_minutes      Int?                    @default(60)
  total_marks           Int?                    @default(100)
  is_active             Boolean?                @default(true)
  created_at            DateTime?               @default(now())
  updated_at            DateTime?               @default(now())
  marks_correct         Decimal?                @default(1) @db.Decimal(10, 0)
  marks_incorrect       Decimal?                @default(0) @db.Decimal(10, 0)
  marks_unattempted     Decimal?                @default(0) @db.Decimal(10, 0)
  subject_id            String?
  exam_attempts         exam_attempts[]
  exam_rank_predictions exam_rank_predictions[]
  mock_test_questions   mock_test_questions[]
  courses               courses                 @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects              subjects?               @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([course_id], map: "idx_mock_tests_course_id")
  @@index([subject_id], map: "idx_mock_tests_subject")
}

model organizations {
  id                   String                 @id @default(uuid())
  name                 String
  slug                 String                 @unique
  logo_url             String?                @db.LongText
  hero_image_url       String?                @db.LongText
  welcome_message      String?
  created_at           DateTime?              @default(now())
  email                String?
  phone                String?
  updated_at           DateTime?              @default(now())
  principal_message    String?
  principal_image      String?                @db.LongText
  contact_messages     contact_messages[]
  profiles             profiles[]
  school_announcements school_announcements[]
  school_testimonials  school_testimonials[]
}

model practice_tests {
  id                String          @id @default(uuid())
  title             String
  description       String?
  subject_id        String?
  duration_minutes  Int?            @default(30)
  is_published      Boolean?        @default(true)
  created_at        DateTime?       @default(now())
  marks_correct     Int?            @default(1)
  marks_incorrect   Int?            @default(0)
  marks_unattempted Int?            @default(0)
  exam_attempts     exam_attempts[]
  subjects          subjects?       @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  questions         questions[]

  @@index([subject_id], map: "practice_tests_subject_id_fkey")
}

model prep_modules {
  id           String      @id @default(uuid())
  title        String
  description  String?
  subject_id   String?
  difficulty   String?     @default("Beginner")
  is_published Boolean?    @default(true)
  created_at   DateTime?   @default(now())
  subjects     subjects?   @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions    questions[]

  @@index([subject_id], map: "prep_modules_subject_id_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profiles {
  id                                                            String                @id
  email                                                         String?
  full_name                                                     String?
  role                                                          String?               @default("student")
  organization_id                                               String?
  created_at                                                    DateTime?             @default(now())
  phone_no                                                      String?
  phone                                                         String?
  updated_at                                                    DateTime?             @default(now())
  stream                                                        String?
  state                                                         String?
  city                                                          String?
  blogs                                                         blogs[]
  organizations                                                 organizations?        @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  student_enrollments_student_enrollments_assigned_byToprofiles student_enrollments[] @relation("student_enrollments_assigned_byToprofiles")
  student_enrollments_student_enrollments_user_idToprofiles     student_enrollments[] @relation("student_enrollments_user_idToprofiles")

  @@index([organization_id], map: "profiles_organization_id_fkey")
}

model question_banks {
  id          String      @id @default(uuid())
  subject_id  String
  title       String
  description String?
  created_at  DateTime    @default(now())
  subjects    subjects    @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions   questions[]

  @@index([subject_id], map: "question_banks_subject_id_fkey")
}

model question_options {
  id          String     @id @default(uuid())
  question_id String?
  text        String
  is_correct  Boolean?   @default(false)
  explanation String?
  questions   questions? @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id], map: "question_options_question_id_fkey")
}

model questions {
  id                  String                @id @default(uuid())
  module_id           String?
  text                String
  explanation         String?
  order_index         Int?                  @default(0)
  created_at          DateTime?             @default(now())
  practice_test_id    String?
  exam_id             String?
  direction           String?
  question_bank_id    String?
  mock_test_questions mock_test_questions[]
  question_options    question_options[]
  exams               exams?                @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prep_modules        prep_modules?         @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  practice_tests      practice_tests?       @relation(fields: [practice_test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question_banks      question_banks?       @relation(fields: [question_bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects            subjects?             @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapters            chapters?             @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topics              topics?               @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  subject_id          String?
  chapter_id          String?
  topic_id            String?
  difficulty          String?
  marks               Decimal?              @db.Decimal(10, 2)
  negative_marks      Decimal?              @db.Decimal(10, 2)
  time_limit          Int?
  status              String?               @default("active")
  tags                String?               @db.Text

  @@index([exam_id], map: "questions_exam_id_fkey")
  @@index([module_id], map: "questions_module_id_fkey")
  @@index([practice_test_id], map: "questions_practice_test_id_fkey")
  @@index([question_bank_id], map: "questions_question_bank_id_fkey")
  @@index([subject_id], map: "questions_subject_id_fkey")
  @@index([chapter_id], map: "questions_chapter_id_fkey")
  @@index([topic_id], map: "questions_topic_id_fkey")
}

model school_announcements {
  id              String        @id @default(uuid())
  organization_id String
  title           String
  content         String
  created_at      DateTime?     @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "school_announcements_organization_id_fkey")
}

model school_testimonials {
  id              String         @id @default(uuid())
  organization_id String?
  student_name    String
  student_image   String?        @db.LongText
  course_name     String?
  message         String
  created_at      DateTime       @default(now())
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "school_testimonials_organization_id_fkey")
}

model student_enrollments {
  id                                                 String    @id @default(uuid())
  user_id                                            String
  subject_id                                         String
  assigned_by                                        String?
  created_at                                         DateTime  @default(now())
  profiles_student_enrollments_assigned_byToprofiles profiles? @relation("student_enrollments_assigned_byToprofiles", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects                                           subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_student_enrollments_user_idToprofiles     profiles  @relation("student_enrollments_user_idToprofiles", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, subject_id])
  @@index([assigned_by], map: "student_enrollments_assigned_by_fkey")
  @@index([subject_id], map: "student_enrollments_subject_id_fkey")
}

model subjects {
  id                   String                 @id @default(uuid())
  course_id            String?
  title                String
  code                 String?
  description          String?                @db.LongText
  status               String?                @default("active")
  created_at           DateTime?              @default(now())
  exams                exams[]
  mock_blueprint_items mock_blueprint_items[]
  mock_tests           mock_tests[]
  practice_tests       practice_tests[]
  prep_modules         prep_modules[]
  question_banks       question_banks[]
  student_enrollments  student_enrollments[]
  chapters             chapters[]
  questions            questions[]
  courses              courses?               @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "subjects_course_id_fkey")
}

model chapters {
  id          String      @id @default(uuid())
  subject_id  String
  name        String
  description String?     @db.LongText
  order       Int         @default(0)
  status      String      @default("active")
  created_at  DateTime?   @default(now())
  updated_at  DateTime?   @default(now()) @updatedAt

  subjects    subjects    @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  topics      topics[]
  questions   questions[]

  @@index([subject_id], map: "chapters_subject_id_fkey")
}

model topics {
  id          String      @id @default(uuid())
  chapter_id  String
  name        String
  description String?     @db.LongText
  order       Int         @default(0)
  status      String      @default("active")
  created_at  DateTime?   @default(now())
  updated_at  DateTime?   @default(now()) @updatedAt

  chapters    chapters    @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  questions   questions[]

  @@index([chapter_id], map: "topics_chapter_id_fkey")
}

model tags {
  id         String    @id @default(uuid())
  name       String    @unique
  created_at DateTime? @default(now())
}

model users {
  id            String          @id @default(uuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?         @db.LongText
  password      String?
  role          String?         @default("student")
  accounts      Account[]
  sessions      Session[]
  attempts      attempts[]
  exam_attempts exam_attempts[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
